{
    "name": "r3bl-fuzzy-search",
    "displayName": "R3BL Fuzzy Search",
    "description": "Interactive fuzzy search powered by fzf/ripgrep and an integrated Git Diff Search Editor for reviewing git changes and recent commits.",
    "version": "1.4.3",
    "publisher": "R3BL",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "search",
        "fzf",
        "ripgrep",
        "vscode",
        "fuzzy"
    ],
    "icon": "r3bl-cube-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/r3bl-org/r3bl-open-core"
    },
    "homepage": "https://r3bl.com",
    "bugs": {
        "url": "https://github.com/r3bl-org/r3bl-open-core/issues"
    },
    "activationEvents": [],
    "extensionDependencies": [
        "R3BL.r3bl-shared"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "r3bl-fuzzy-search.searchInFiles",
                "title": "Interactive Search",
                "category": "R3BL"
            },
            {
                "command": "r3bl-fuzzy-search.showUnstagedChanges",
                "title": "Git Diff Search Editor",
                "category": "R3BL"
            },
            {
                "command": "r3bl-fuzzy-search.refreshGitDiff",
                "title": "Refresh Git Diff Search Editor",
                "category": "R3BL"
            }
        ],
        "keybindings": [
            {
                "command": "r3bl-fuzzy-search.searchInFiles",
                "key": "alt+shift+d",
                "mac": "alt+shift+d",
                "when": "editorTextFocus || !editorTextFocus"
            },
            {
                "command": "r3bl-fuzzy-search.showUnstagedChanges",
                "key": "ctrl+shift+g",
                "mac": "ctrl+shift+g",
                "when": "editorTextFocus || !editorTextFocus"
            },
            {
                "command": "r3bl-fuzzy-search.refreshGitDiff",
                "key": "ctrl+r",
                "mac": "cmd+r",
                "when": "editorTextFocus && editorLangId == 'search-result'"
            }
        ],
        "configuration": {
            "title": "R3BL Fuzzy Search",
            "properties": {
                "r3blFuzzySearch.fzfPath": {
                    "type": "string",
                    "default": "fzf",
                    "description": "Path to fzf executable"
                },
                "r3blFuzzySearch.ripgrepPath": {
                    "type": "string",
                    "default": "rg",
                    "description": "Path to ripgrep executable"
                },
                "r3blFuzzySearch.defaultExcludePattern": {
                    "type": "string",
                    "default": "**/node_modules/**,**/.git/**,**/.vscode/**,**/target/**",
                    "description": "Default comma-separated glob patterns for files to exclude"
                },
                "r3blFuzzySearch.resultLimit": {
                    "type": "number",
                    "default": 100,
                    "minimum": 1,
                    "maximum": 10000,
                    "description": "Maximum number of search results to display"
                },
                "r3blFuzzySearch.respectGitignore": {
                    "type": "boolean",
                    "default": true,
                    "description": "Respect .gitignore files when searching (disable to search in gitignored files)"
                },
                "r3blFuzzySearch.commitHistoryLimit": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 50,
                    "description": "Maximum number of recent commits to show in the Git Diff Search Editor picker"
                },
                "r3blFuzzySearch.gitDiffMaxLinesPerFile": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Maximum number of changed lines/preview lines displayed per file in the Git Diff Search Editor"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "compile": "webpack",
        "watch": "webpack --watch",
        "build": "webpack --mode production --devtool hidden-source-map",
        "package": "vsce package --no-dependencies",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "test": "jest"
    },
    "dependencies": {
        "r3bl-common-code": "file:../r3bl-common-code"
    },
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "typescript": "^5.0.0",
        "ts-loader": "^9.5.1",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    }
}
