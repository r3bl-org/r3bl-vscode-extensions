{
    "name": "r3bl-fuzzy-search",
    "displayName": "R3BL Fuzzy Search",
    "description": "Fuzzy search in files using fzf - fast and smart search with Search Editor results",
    "version": "1.1.3",
    "publisher": "R3BL",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "search",
        "fzf",
        "fuzzy",
        "ripgrep",
        "find",
        "file search",
        "fuzzy finder",
        "grep"
    ],
    "icon": "r3bl-cube-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/r3bl-org/r3bl-vscode-extensions.git",
        "directory": "packages/r3bl-fuzzy-search"
    },
    "activationEvents": [],
    "extensionDependencies": [
        "R3BL.r3bl-shared"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "r3bl-fuzzy-search.searchInFiles",
                "title": "R3BL Fuzzy Search: Interactive Search",
                "category": "R3BL"
            }
        ],
        "keybindings": [
            {
                "command": "r3bl-fuzzy-search.searchInFiles",
                "key": "alt+shift+d",
                "mac": "alt+shift+d",
                "when": "editorTextFocus || !editorTextFocus"
            }
        ],
        "configuration": {
            "title": "R3BL Fuzzy Search",
            "properties": {
                "r3blFuzzySearch.fzfPath": {
                    "type": "string",
                    "default": "fzf",
                    "description": "Path to fzf executable"
                },
                "r3blFuzzySearch.ripgrepPath": {
                    "type": "string",
                    "default": "rg",
                    "description": "Path to ripgrep executable"
                },
                "r3blFuzzySearch.defaultExcludePattern": {
                    "type": "string",
                    "default": "**/node_modules/**,**/.git/**,**/.vscode/**,**/target/**",
                    "description": "Default comma-separated glob patterns for files to exclude"
                },
                "r3blFuzzySearch.resultLimit": {
                    "type": "number",
                    "default": 100,
                    "minimum": 1,
                    "maximum": 10000,
                    "description": "Maximum number of search results to display"
                },
                "r3blFuzzySearch.respectGitignore": {
                    "type": "boolean",
                    "default": true,
                    "description": "Respect .gitignore files when searching (disable to search in gitignored files)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "compile": "webpack",
        "watch": "webpack --watch",
        "build": "webpack --mode production --devtool hidden-source-map",
        "package": "vsce package --no-dependencies",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "dependencies": {
        "r3bl-common-code": "file:../r3bl-common-code"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "@types/mocha": "^10.0.0",
        "@vscode/test-electron": "^2.3.0",
        "mocha": "^10.0.0",
        "typescript": "^5.0.0",
        "ts-loader": "^9.5.1",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    }
}
