{
    "name": "r3bl-theme",
    "displayName": "R3BL Theme",
    "description": "Dark theme optimized for Rust and Markdown with enhanced semantic highlighting and eye comfort",
    "version": "1.0.18",
    "publisher": "R3BL",
    "extensionDependencies": [
        "R3BL.r3bl-semantic-config"
    ],
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "color theme",
        "dark theme",
        "rust",
        "rust theme",
        "markdown",
        "syntax highlighting",
        "semantic highlighting",
        "code theme",
        "programming theme",
        "r3bl"
    ],
    "icon": "r3bl-cube-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/r3bl-org/r3bl-vscode-extensions.git",
        "directory": "packages/r3bl-theme"
    },
    "scripts": {
        "package": "vsce package --no-dependencies"
    },
    "contributes": {
        "themes": [
            {
                "label": "R3BL Theme",
                "uiTheme": "vs-dark",
                "path": "./themes/r3bl-theme-color-theme.json"
            }
        ]
    }
}
