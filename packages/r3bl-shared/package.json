{
    "name": "r3bl-shared",
    "displayName": "R3BL Shared Utilities",
    "description": "Shared utilities and APIs for R3BL VSCode extensions (automatically installed as dependency)",
    "version": "1.0.0",
    "publisher": "R3BL",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/r3bl-org/r3bl-vscode-extensions",
        "directory": "packages/r3bl-shared"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "r3bl",
        "shared",
        "utilities",
        "internal"
