{
    "name": "r3bl-semantic-config",
    "displayName": "R3BL Semantic Configuration",
    "description": "Companion to R3BL Theme - automatically applies enhanced semantic highlighting for Rust development",
    "version": "1.2.10",
    "publisher": "R3BL",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "semantic highlighting",
        "syntax highlighting",
        "configuration",
        "rust",
        "settings"
    ],
    "extensionDependencies": [
        "R3BL.r3bl-shared",
        "rust-lang.rust-analyzer"
    ],
    "icon": "r3bl-cube-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/r3bl-org/r3bl-vscode-extensions.git",
        "directory": "packages/r3bl-semantic-config"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "r3bl-semantic-config.enable",
                "title": "Enable R3BL Semantic Highlighting",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.disable",
                "title": "Disable R3BL Semantic Highlighting",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.runFlycheck",
                "title": "Run Flycheck (Debounced)",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.foldRustdocs",
                "title": "Fold All Rustdocs",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.unfoldRustdocs",
                "title": "Unfold All Rustdocs",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.navigateRustdocs",
                "title": "Navigate Rustdoc Structure",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.scrollToTop",
                "title": "Scroll Current Line to Top",
                "category": "R3BL"
            },
            {
                "command": "r3bl-semantic-config.insertRustdocLinkDef",
                "title": "Insert Rustdoc Link Definition",
                "category": "R3BL"
            }
        ],
        "keybindings": [
            {
                "command": "r3bl-semantic-config.runFlycheck",
                "key": "ctrl+r",
                "when": "editorTextFocus && !editorReadonly && editorLangId == rust"
            },
            {
                "command": "r3bl-semantic-config.foldRustdocs",
                "key": "ctrl+-",
                "when": "editorTextFocus && editorLangId == rust"
            },
            {
                "command": "r3bl-semantic-config.unfoldRustdocs",
                "key": "ctrl+=",
                "when": "editorTextFocus && editorLangId == rust"
            },
            {
                "command": "r3bl-semantic-config.navigateRustdocs",
                "key": "ctrl+shift+y",
                "when": "editorTextFocus && editorLangId == rust"
            },
            {
                "command": "r3bl-semantic-config.scrollToTop",
                "key": "ctrl+m",
                "when": "editorTextFocus"
            },
            {
                "command": "r3bl-semantic-config.insertRustdocLinkDef",
                "key": "ctrl+shift+l",
                "when": "editorTextFocus && editorLangId == rust"
            }
        ],
        "configuration": {
            "title": "R3BL Semantic Configuration",
            "properties": {
                "r3bl-semantic-config.debouncedFlycheck.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable debounced flycheck for Rust files. Automatically runs rust-analyzer flycheck after a period of inactivity."
                },
                "r3bl-semantic-config.debouncedFlycheck.delayMs": {
                    "type": "number",
                    "default": 1000,
                    "minimum": 100,
                    "maximum": 10000,
                    "description": "Delay in milliseconds before running flycheck after the last keystroke."
                },
                "r3bl-semantic-config.debouncedFlycheck.languages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "rust"
                    ],
                    "description": "List of language IDs to enable debounced flycheck for."
                },
                "r3bl-semantic-config.debouncedFlycheck.autoDisableCheckOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically disable rust-analyzer.checkOnSave when debounced flycheck is enabled."
                },
                "r3bl-semantic-config.autoFoldRustdocsOnOpen": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically fold all rustdoc comments (/// and //!) when opening a Rust file."
                },
                "r3bl-semantic-config.insertRustdocLinkDef.maxResults": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 50,
                    "description": "The maximum number of unique link definitions to show in the QuickPick menu when auto-inserting."
                },
                "r3bl-semantic-config.autoFoldUseStatementsOnOpen": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically fold all Rust 'use' statements at the top of a file when opening a Rust file."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "compile": "webpack",
        "watch": "webpack --watch",
        "build": "webpack --mode production --devtool hidden-source-map",
        "package": "vsce package --no-dependencies",
        "test": "jest"
    },
    "dependencies": {
        "r3bl-common-code": "file:../r3bl-common-code"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "14.x",
        "@types/vscode": "^1.60.0",
        "jest": "^30.3.0",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.1",
        "typescript": "^5.0.0",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    }
}
